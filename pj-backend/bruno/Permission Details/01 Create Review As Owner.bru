meta {
  name: 01 Create Review As Owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/places/{{seedPlaceId}}/reviews
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

body:json {
  {
    "rating": 4,
    "comment": "รีวิวสำหรับทดสอบสิทธิ์"
  }
}

tests {
  test("เจ้าของสร้าง Review สำหรับทดสอบได้", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("permissionReviewId", res.getBody().review_id);
  });
}
