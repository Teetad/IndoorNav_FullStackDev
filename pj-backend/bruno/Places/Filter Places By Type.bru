meta {
  name: Filter Places By Type
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/places?place_type=laboratory
  body: none
  auth: none
}

tests {
  test("filters places by type", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows).to.be.an("array");
    expect(rows.every(row => row.place_type === "laboratory")).to.equal(true);
  });
}
