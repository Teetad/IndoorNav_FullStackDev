meta {
  name: Update Place Not Found
  type: http
  seq: 94
}

put {
  url: {{baseUrl}}/places/{{unknownId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{developerToken}}
}

body:json {
  { "place_name": "Unknown" }
}

tests {
  test("returns 404 when updating an unknown place", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
