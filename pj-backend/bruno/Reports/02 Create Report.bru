}

body:json {
  {
    "description": "ป้ายชื่อห้องไม่ชัดเจน"
  }
}

tests {
  test("User ส่ง Report ได้", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("PENDING");
    bru.setVar("testReportId", res.getBody().report_id);
  });
}
