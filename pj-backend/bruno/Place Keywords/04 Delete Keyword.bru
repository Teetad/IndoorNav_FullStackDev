meta {
  name: 04 Delete Keyword
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/places/{{mapPlaceId}}/keywords/{{testKeywordId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("deletes the keyword", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.keyword_id).to.equal(bru.getVar("testKeywordId"));
  });
}
