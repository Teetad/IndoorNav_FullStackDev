meta {
  name: 01 Current User copy
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("เข้าสู่ระบบแล้วและเป็นผู้ใช้ทั่วไป", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("USER");
  });
}
