delete {
  url: {{baseUrl}}/reviews/{{testReviewId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("เจ้าของลบรีวิวตัวเองได้", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.review_id).to.equal(bru.getVar("testReviewId"));
  });
}
