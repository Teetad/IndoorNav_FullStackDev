post {
  url: {{baseUrl}}/places/{{seedPlaceId}}/reviews
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

body:json {
  {
    "rating": 5,
    "comment": "รีวิวซ้ำ"
  }
}

tests {
  test("ผู้ใช้รีวิวสถานที่เดิมซ้ำไม่ได้", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
