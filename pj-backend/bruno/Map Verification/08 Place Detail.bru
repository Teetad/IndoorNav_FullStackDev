meta {
  name: 08 Place Detail
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/places/{{mapPlaceId}}
  body: none
  auth: none
}

tests {
  test("08 Place Detail", function () {
    expect(res.getStatus()).to.equal(200);
    const place = res.getBody();
    expect(place.place_id).to.equal(bru.getVar("mapPlaceId"));
    expect(place.room_number).to.equal("413A");
    expect(place.place_type).to.equal("classroom");
    expect(place.floor_number).to.equal(4);
    expect(place.building_name).to.equal("อาคาร 30 ปี");
  });
}
