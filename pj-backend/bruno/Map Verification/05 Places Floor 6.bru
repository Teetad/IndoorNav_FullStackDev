meta {
  name: 05 Places Floor 6
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/places?building_id={{mapBuildingId}}&floor=6
  body: none
  auth: none
}

tests {
  test("05 Places Floor 6", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows).to.be.an("array");
    expect(rows.length).to.be.greaterThan(0);
    expect(rows.every(row => row.floor_number === 6 && row.building_id === bru.getVar("mapBuildingId"))).to.equal(true);
    expect(rows.some(row => row.place_name === "ห้องประชุม")).to.equal(true);
  });
}

