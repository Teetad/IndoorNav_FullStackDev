meta {
  name: Get Building By ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/buildings/{{seedBuildingId}}
  body: none
  auth: none
}

vars:pre-request {
  seedBuildingId: 29359a72-7a7d-4cfa-8e2a-e78fdaa2af2f
}

tests {
  test("returns a building", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("building_id");
  });
}
