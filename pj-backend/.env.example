# Backend application port
PORT=3000
PROD_PORT=3000

# Notice that we do not need superuser credential anymore.
POSTGRES_DB=mydb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=5678

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

DEBUG=pj*

# Generate a long random value for signing OAuth state and application sessions.
JWT_SECRET=replace_with_a_long_random_secret

# CPE OAuth: keep the real client secret only in .env, never commit it.
OAUTH_CLIENT_ID=MWM9PxVFyADkwn6pTSxbKlVbw4Fq7me2xzOGLqW4
OAUTH_CLIENT_SECRET=fill_from_course_credentials
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_SCOPE=openid profile email basic_info
OAUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Comma-separated CMU emails that receive ADMIN on login. Other users receive USER.
ADMIN_EMAILS=

# Developer operates seed/map data and is separate from the normal application user.
DEVELOPER_EMAILS=
